# Copy to .env (git-ignored) and replace the REPLACE_ME values.

# PostgreSQL (must match the postgres service in docker-compose.yml)
SPRING_DATASOURCE_USERNAME=paperless
SPRING_DATASOURCE_PASSWORD=paperless_password

# RabbitMQ
RABBIT_USER=paperless
RABBIT_PASSWORD=REPLACE_ME
RABBIT_VHOST=paperless

# JWT signing key: Base64, at least 32 bytes (e.g. openssl rand -base64 32)
JWT_SECRET=REPLACE_ME

# Object storage (Silo, MinIO-compatible); secret key needs at least 8 characters
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=paperless
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=documents
